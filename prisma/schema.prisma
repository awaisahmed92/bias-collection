// Bias Collection — Database schema
// Dev uses SQLite. For PostgreSQL: change provider to "postgresql", set DATABASE_URL,
// and swap Float money columns to Decimal. All relations/indexes are portable.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────── USERS & RBAC ───────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  carts         Cart[]
  notifications Notification[]
  couponUsages  CouponUsage[]
  auditLogs     AuditLog[]
  statusChanges OrderStatusHistory[]
  inventoryLogs InventoryLog[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique // super_admin | admin | staff | customer
  label       String
  description String?
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // e.g. products.view
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String  @default("Home")
  firstName  String
  lastName   String
  phone      String
  country    String  @default("Pakistan")
  city       String
  area       String
  address    String
  postalCode String?
  isDefault  Boolean @default(false)
}

// ─────────────────────────────── CATALOG ───────────────────────────────

model Category {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  description    String?
  image          String?
  parentId       String?
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[] @relation("CategoryTree")
  seoTitle       String?
  seoDescription String?
  displayOrder   Int        @default(0)
  isActive       Boolean    @default(true)
  products       Product[]
  promotions     PromotionCategory[]
}

model Product {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  shortDescription  String?
  description       String?
  sku               String   @unique
  barcode           String?
  brand             String   @default("Bias Collection")
  categoryId        String
  category          Category @relation(fields: [categoryId], references: [id])
  tags              String   @default("") // comma-separated for portability
  originalPrice     Float
  salePrice         Float?
  costPrice         Float?
  stock             Int      @default(0)
  reservedStock     Int      @default(0)
  lowStockThreshold Int      @default(5)
  weight            Float?
  status            String   @default("ACTIVE") // DRAFT | ACTIVE | ARCHIVED
  isFeatured        Boolean  @default(false)
  isNewArrival      Boolean  @default(false)
  isBestSeller      Boolean  @default(false) // manual override; auto uses soldCount
  allowBackorder    Boolean  @default(false)
  soldCount         Int      @default(0)
  viewCount         Int      @default(0)
  seoTitle          String?
  seoDescription    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  images         ProductImage[]
  variants       ProductVariant[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  wishlistItems  WishlistItem[]
  reviews        Review[]
  inventoryLogs  InventoryLog[]
  promoLinks     PromotionProduct[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)
}

model ProductVariant {
  id            String  @id @default(cuid())
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size          String?
  color         String?
  sku           String  @unique
  price         Float? // null => inherit product price
  salePrice     Float?
  stock         Int     @default(0)
  reservedStock Int     @default(0)
  weight        Float?
  image         String?
  isActive      Boolean @default(true)

  cartItems     CartItem[]
  orderItems    OrderItem[]
  inventoryLogs InventoryLog[]
}

// ─────────────────────────────── CART & WISHLIST ───────────────────────────────

model Cart {
  id        String     @id @default(cuid())
  token     String     @unique // guest cart session cookie value
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int            @default(1)
  priceAtAdd Float          // catalog price captured when added (historical)
  createdAt DateTime       @default(now())

  @@unique([cartId, productId, variantId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ─────────────────────────────── ORDERS & PAYMENTS ───────────────────────────────

model Order {
  id                 String   @id @default(cuid())
  orderNumber        String   @unique
  userId             String?
  user               User?    @relation(fields: [userId], references: [id])
  // customer snapshot
  customerFirstName  String
  customerLastName   String
  email              String
  phone              String
  // shipping address snapshot
  shippingCountry    String   @default("Pakistan")
  shippingCity       String
  shippingArea       String
  shippingAddress    String
  shippingPostalCode String?
  // money
  subtotal           Float
  productSavings     Float    @default(0) // discounts baked into line prices
  couponCode         String?
  couponDiscount     Float    @default(0)
  shippingCost       Float    @default(0)
  taxTotal           Float    @default(0)
  total              Float
  // fulfilment
  shippingMethodId   String?
  shippingMethodName String?
  status             String   @default("PENDING")
  // PENDING|CONFIRMED|PROCESSING|PACKED|SHIPPED|DELIVERED|CANCELLED|RETURNED|REFUNDED
  paymentMethod      String // cod | bank_transfer | card | wallet
  paymentStatus      String   @default("PENDING") // PENDING|PAID|FAILED|REFUNDED|PARTIALLY_REFUNDED
  trackingNumber     String?
  customerNote       String?
  internalNotes      String?
  placedAt           DateTime @default(now())
  updatedAt          DateTime @updatedAt

  items    OrderItem[]
  history  OrderStatusHistory[]
  payments Payment[]
}

model OrderItem {
  id            String          @id @default(cuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?        @relation(fields: [productId], references: [id])
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  productName   String
  variantName   String?
  sku           String?
  image         String?
  quantity      Int
  originalPrice Float // catalog price before item-level discounts
  finalPrice    Float // per-unit price charged
  lineTotal     Float
}

model OrderStatusHistory {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      String
  note        String?
  changedById String?
  changedBy   User?    @relation(fields: [changedById], references: [id])
  createdAt   DateTime @default(now())
}

model Payment {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method           String
  amount           Float
  status           String   @default("PENDING") // PENDING|SUCCESS|FAILED|REFUNDED
  transactionId    String?
  providerResponse String? // JSON string
  createdAt        DateTime @default(now())
}

// ─────────────────────────────── PROMOTIONS & COUPONS ───────────────────────────────

model Promotion {
  id            String    @id @default(cuid())
  name          String
  description   String?
  type          String // STORE_WIDE | CATEGORY | PRODUCT | FLASH | BUY_X_GET_Y | FREE_SHIPPING
  discountType  String    @default("PERCENTAGE") // PERCENTAGE | FIXED | FREE_SHIPPING
  discountValue Float     @default(0) // % or fixed; for FREE_SHIPPING & BUY_X_GET_Y = threshold/qty config in configJson
  configJson    String?   @default("{}") // extra rules e.g. {"buy":2,"get":1}
  startDate     DateTime?
  endDate       DateTime?
  isActive      Boolean   @default(true)
  priority      Int       @default(0)
  createdAt     DateTime  @default(now())

  products   PromotionProduct[]
  categories PromotionCategory[]
}

model PromotionProduct {
  promotionId String
  productId   String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
}

model PromotionCategory {
  promotionId String
  categoryId  String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  type           String // PERCENTAGE | FIXED | FREE_SHIPPING
  amount         Float     @default(0)
  minOrderAmount Float?
  maxDiscount    Float?
  startDate      DateTime?
  endDate        DateTime?
  usageLimit     Int?
  usagePerCustomer Int?
  usedCount      Int      @default(0)
  appliesTo      String   @default("ALL") // ALL | PRODUCTS | CATEGORIES
  productIds     String? // comma-separated ids when appliesTo=PRODUCTS
  categoryIds    String? // comma-separated ids when appliesTo=CATEGORIES
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  usages CouponUsage[]
}

model CouponUsage {
  id       String   @id @default(cuid())
  couponId String
  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?    @relation(fields: [userId], references: [id])
  orderId  String?
  createdAt DateTime @default(now())
}

// ─────────────────────────────── INVENTORY ───────────────────────────────

model InventoryLog {
  id          String          @id @default(cuid())
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  type        String // STOCK_ADDED | STOCK_SOLD | STOCK_RETURNED | STOCK_DAMAGED | MANUAL_ADJUSTMENT
  quantity    Int // signed (+/-)
  before      Int
  after       Int
  reference   String? // e.g. order number
  note        String?
  createdById String?
  createdBy   User?           @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
}

// ─────────────────────────────── REVIEWS / CMS / COMMS ───────────────────────────────

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int // 1-5
  comment   String?
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt DateTime @default(now())
}

model Banner {
  id            String    @id @default(cuid())
  title         String?
  subtitle      String?
  desktopImage  String
  mobileImage   String?
  linkUrl       String?
  buttonText    String?
  position      String // HOME_HERO | HOME_MIDDLE | CATEGORY_PAGE | PRODUCT_PAGE | SALE_PAGE
  startDate     DateTime?
  endDate       DateTime?
  displayOrder  Int       @default(0)
  isActive      Boolean   @default(true)
}

model HomepageSection {
  id           String  @id @default(cuid())
  type         String // HERO | CATEGORY_GRID | NEW_ARRIVALS | FEATURED_PRODUCTS | PROMO_BANNER | BEST_SELLERS | SALE_BANNER | NEWSLETTER
  title        String?
  subtitle     String?
  image        String?
  buttonText   String?
  buttonLink   String?
  configJson   String  @default("{}") // section-specific: productIds, categoryIds, maxItems, sale info...
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   String   @default("EMAIL") // EMAIL | SMS | WHATSAPP
  type      String // ORDER_CONFIRMED | ORDER_SHIPPED | ... | ADMIN_NEW_ORDER | ADMIN_LOW_STOCK ...
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ShippingMethod {
  id          String  @id @default(cuid())
  name        String
  description String?
  zone        String? // e.g. "Karachi", "Other Cities". null = all zones.
  price       Float   @default(0)
  freeAbove   Float? // free when subtotal >= freeAbove
  minDays     Int     @default(2)
  maxDays     Int     @default(5)
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
}

model PaymentMethodConfig {
  id           String  @id @default(cuid())
  key          String  @unique // cod | bank_transfer | card | wallet
  name         String
  description  String?
  instructions String? // shown to customer e.g. bank account details
  configJson   String  @default("{}") // non-secret config only (keys stay in .env)
  isEnabled    Boolean @default(true)
  sortOrder    Int     @default(0)
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // create | update | delete | status_change ...
  entity    String // product | order | coupon ...
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
}
